# Bucard Web Automation Configuration Template
# Copy this file to .env and fill in test credentials when available.

# Target site URL
BUCARD_BASE_URL=https://bucard.az

# Browser settings
BROWSER_HEADLESS=true
BROWSER_NAME=chrome
TIMEOUT_EXPLICIT_SECONDS=10
TIMEOUT_PAGELOAD_SECONDS=30

# Existing Free/General Test Account (optional; if omitted, dynamic temp-mail account is created)
# BUCARD_TEST_USER=
# BUCARD_TEST_PASSWORD=

# Public Pro Account A (TD-PRO-PUBLIC) for Share & QR E2E Tests (E2E-009 — E2E-012)
# Option 1 (Full Link + Live QR Decoding): provide login credentials of Public Pro account A
# BUCARD_PRO_USER=
# BUCARD_PRO_PASSWORD=
# Option 2 (Direct URL/Identity without logging in as A): provide username/full name/share URL
# BUCARD_PRO_USERNAME=
# BUCARD_PRO_FULLNAME=
# BUCARD_PRO_SHARE_URL=
# BUCARD_PRO_QR_IMAGE_URL=

# Reporting (optional)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# ALLURE_REPORT_URL=https://bucard-tech.github.io/bucardwebauto/
