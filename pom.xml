<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
 <modelVersion>4.0.0</modelVersion><groupId>az.bucard</groupId><artifactId>bucardwebauto</artifactId><version>0.1.0-SNAPSHOT</version>
 <properties><maven.compiler.release>17</maven.compiler.release><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding><selenium.version>4.26.0</selenium.version><testng.version>7.10.2</testng.version></properties>
 <dependencies>
  <dependency><groupId>org.seleniumhq.selenium</groupId><artifactId>selenium-java</artifactId><version>${selenium.version}</version></dependency>
  <dependency><groupId>org.testng</groupId><artifactId>testng</artifactId><version>${testng.version}</version><scope>test</scope></dependency>
 </dependencies>
 <build><plugins>
  <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version><configuration><release>${maven.compiler.release}</release></configuration></plugin>
  <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.2</version><configuration><suiteXmlFiles><suiteXmlFile>src/test/resources/testng.xml</suiteXmlFile></suiteXmlFiles><systemPropertyVariables><bucard.baseUrl>${bucard.baseUrl}</bucard.baseUrl><browser.headless>${browser.headless}</browser.headless></systemPropertyVariables></configuration></plugin>
 </plugins></build>
 <profiles><profile><id>default-config</id><activation><activeByDefault>true</activeByDefault></activation><properties><bucard.baseUrl>https://bucard.az</bucard.baseUrl><browser.headless>true</browser.headless></properties></profile></profiles>
</project>
