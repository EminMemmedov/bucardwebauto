<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Bucard Web Automation" verbose="1">
    <test name="Unit Tests (In-Memory)">
        <classes>
            <class name="az.bucard.unit.ConfigTest"/>
            <class name="az.bucard.unit.SanitizerTest"/>
        </classes>
    </test>

    <test name="Public Smoke Checks">
        <classes>
            <class name="az.bucard.smoke.SiteAvailabilityTest"/>
            <class name="az.bucard.smoke.PublicRoutesSmokeTest"/>
            <class name="az.bucard.smoke.LoginPageSmokeTest"/>
            <class name="az.bucard.smoke.RegisterPageSmokeTest"/>
            <class name="az.bucard.smoke.ForgotPasswordSmokeTest"/>
            <class name="az.bucard.smoke.LocalizationSmokeTest"/>
        </classes>
    </test>

    <test name="Negative &amp; Security Checks">
        <classes>
            <class name="az.bucard.smoke.NegativeScenariosSmokeTest"/>
        </classes>
    </test>

    <test name="Dynamic Temp-Mail Registration &amp; Auth">
        <classes>
            <class name="az.bucard.smoke.DynamicRegistrationSmokeTest"/>
        </classes>
    </test>

    <test name="Business Core Suites (P0, P1, P2)">
        <classes>
            <class name="az.bucard.business.AuthAndProfileBusinessTest"/>
            <class name="az.bucard.business.BoxesAndContactsBusinessTest"/>
            <class name="az.bucard.business.SubscriptionAndBonusBusinessTest"/>
            <class name="az.bucard.business.NotificationsBusinessTest"/>
        </classes>
    </test>
</suite>
